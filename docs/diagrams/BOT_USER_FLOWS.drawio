  <diagram id="screens-2" name="Администратор бота">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2420" pageHeight="18072">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" value="Экраны" />
        <mxCell id="forward" parent="0" value="Основные переходы" />
        <mxCell id="returns" parent="0" value="Возвраты и меню" visible="0" />
        <mxCell id="cross" parent="0" value="Между сценариями" visible="0" />
        <mxCell id="loops" parent="0" value="Изменение значений" visible="0" />
        <mxCell id="title" value="Администратор бота · экраны и переходы от кнопок" style="fontSize=30;fontColor=#1e344a;align=left;strokeColor=none;fillColor=none;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="2340" height="65" />
        </mxCell>
        <mxCell id="help" value="Экраны выгружены из Screens.render: выпуск с календарём, настройками начала и снятием закрепов. Стрелка начинается у кнопки или поля ответа. Петля меняет данные на этом же экране. Примерные значения не описывают все возможные суммы.&lt;br&gt;По умолчанию видны основные маршруты внутри сценария. Слои «Возвраты и меню», «Между сценариями», «Изменение значений» включаются через Вид → Слои. Отмена с несохранённым вводом ведёт к подтверждению." style="fontSize=16;align=left;strokeColor=none;fillColor=none;fontColor=#486071;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="105" width="2340" height="90" />
        </mxCell>
        <mxCell id="section0" value="Участие в общем чате" style="fontSize=25;align=left;fillColor=#e5eef5;strokeColor=none;fontColor=#253f58;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="260" width="2340" height="48" />
        </mxCell>
        <mxCell id="section1" value="Личное меню, создание и учёт" style="fontSize=25;align=left;fillColor=#e5eef5;strokeColor=none;fontColor=#253f58;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
