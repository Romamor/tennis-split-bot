        <mxCell id="title" value="Участник · экраны и переходы от кнопок" style="fontSize=30;fontColor=#1e344a;align=left;strokeColor=none;fillColor=none;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
