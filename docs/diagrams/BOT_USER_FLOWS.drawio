  <diagram id="screens-2" name="Администратор бота">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2420" pageHeight="27169">
      <root>
