        <mxCell id="screen-poll_training-body" value="&lt;div style=&quot;padding:18px;border:1px solid #637d93;border-radius:8px;text-align:center;margin-bottom:10px&quot;&gt;🖼 Фото из опроса&lt;/div&gt;&lt;div style=&quot;font-size:19px;margin-bottom:9px&quot;&gt;Теннис&lt;/div&gt;&lt;p&gt;12.09.2026 18:30&lt;br&gt;Статус: Открыта&lt;/p&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-weight:normal;border-bottom:1px solid #52606c;padding:5px&quot;&gt;Участник&lt;/th&gt;&lt;th style=&quot;font-weight:normal;border-bottom:1px solid #52606c;padding:5px&quot;&gt;Время&lt;/th&gt;&lt;th style=&quot;font-weight:normal;border-bottom:1px solid #52606c;padding:5px&quot;&gt;Оплата&lt;/th&gt;&lt;th style=&quot;font-weight:normal;border-bottom:1px solid #52606c;padding:5px&quot;&gt;Баланс&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;Глеб&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;0 ч&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;0 ₽&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;0 ₽&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Час: —&lt;/p&gt;" style="rounded=1;arcSize=8;fillColor=#2d3339;strokeColor=#2d3339;fontColor=#f2f6fb;fontSize=14;align=left;verticalAlign=top;spacing=14;overflow=hidden;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="screen-poll_training">
