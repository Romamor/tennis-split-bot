        <mxCell id="screen-finance_balances-body" value="&lt;div style=&quot;font-size:19px;margin-bottom:9px&quot;&gt;Баланс группы&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;font-weight:normal;border-bottom:1px solid #52606c;padding:5px&quot;&gt;Участник&lt;/th&gt;&lt;th style=&quot;font-weight:normal;border-bottom:1px solid #52606c;padding:5px&quot;&gt;Баланс&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;Глеб&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#fff;background:#bd454c;border-radius:4px;padding:3px 7px&quot;&gt;−100 ₽&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;Денис&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;0 ₽&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;Елена&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;0 ₽&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;Ирина&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;border-bottom:1px solid #52606c;padding:5px&quot;&gt;&lt;span style=&quot;color:#a6d8fc&quot;&gt;0 ₽&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Нажми на имя для профиля, на баланс — для перевода.&lt;/p&gt;" style="rounded=1;arcSize=8;fillColor=#2d3339;strokeColor=#2d3339;fontColor=#f2f6fb;fontSize=1