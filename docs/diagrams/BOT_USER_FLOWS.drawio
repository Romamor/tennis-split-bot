        <mxCell id="screen-poll_settings-label" value="Настройки выбранной группы" style="fontSize=17;fontStyle=1;align=left;fontColor=#314b65;strokeColor=none;fillColor=none;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="screen-poll_settings">
