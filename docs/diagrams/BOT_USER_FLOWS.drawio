        <mxCell id="I-super" value="Не может назначать / снимать&#10;других администраторов" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3d6;strokeColor=#ae8633;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2870" y="3410" width="310" height="160" />
        </mxCell>
        <mxCell id="I-transfer" value="Переводы в личном интерфейсе:&#10;изменение только своей стороны&#10;Старшая роль не заменяет участие" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3d6;strokeColor=#ae8633;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3240" y="3410" width="310" height="160" />
        </mxCell>
        <mxCell id="I-loss" value="Назначение снято&#10;Следующее действие проверяет права&#10;Старые кнопки не дают доступа" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fdecec;strokeColor=#b56363;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2500" y="3660" width="310" height="160" />
        </mxCell>
        <mxCell id="I-creator" value="Если админ — создатель:&#10;после снятия роли он может учесть&#10;свою тренировку, пока состоит в группе" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3d6;strokeColor=#ae8633;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2870" y="3660" width="310" height="160" />
        </mxCell>
        <mxCell id="I-other" value="Назначение в другой группе&#10;не даёт прав здесь" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3d6;strokeColor=#ae8633;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3240" y="3660" width="310" height="160" />
        </mxCell>
        <mxCell id="footer" value="Общие возвраты и ошибки — раздел F. Одинаковые имена → проверка профиля; новая текстовая реплика → ответ внизу личного чата.&#10;Это схема реализованных маршрутов. Поля «ходит» / никнейм и представительство в переводах не имеют отдельного пользовательского интерфейса." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#8290a3;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="4700" width="3600" height="80" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
