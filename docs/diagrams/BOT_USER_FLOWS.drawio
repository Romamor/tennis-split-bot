        <mxCell id="screen-rules_settings-body" value="Теннис по субботам&lt;br&gt;Настройки группы&lt;br&gt;Гости и учёт времени применяются к новым и открытым тренировкам. Запрет гостей не удаляет записанных. Без учёта времени стоимость делится поровну; введённые длительности сохраняются и вернутся при включении. Учтённые расчёты не меняются.&lt;br&gt;Сбор через опрос разрешает создавать опрос перед тренировкой. Обычное создание остаётся доступным; опубликованные опросы можно завершить после выключения." style="rounded=1;arcSize=8;fillColor=#2d3339;strokeColor=#2d3339;fontColor=#f2f6fb;fontSize=14;align=left;verticalAlign=top;spacing=14;overflow=hidden;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="screen-rules_settings">
          <mxGeometry as="geometry" x="0" y="66" width="430" height="308" />
        </mxCell>
        <mxCell id="screen-rules_settings-button0-0" value="👥 Гости: запрещены" style="rounded=1;arcSize=10;fillColor=#414b55;strokeColor=#414b55;fontColor=#ecf5ff;fontSize=14;align=center;verticalAlign=middle;spacing=6;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="screen-rules_settings">
          <mxGeometry as="geometry" x="0.0" y="379" width="430.0" height="43" />
        </mxCell>
        <mxCell id="screen-rules_settings-button1-0" value="🕒 Учёт времени: выключен" style="rounded=1;arcSize=10;fillColor=#414b55;strokeColor=#414b55;fontColor=#ecf5ff;fontSize=14;align=center;verticalAlign=middle;spacing=6;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="screen-rules_settings">
          <mxGeometry as="geometry" x="0.0" y="427" width="430.0" height="43" />
        </mxCell>
        <mxCell id="screen-rules_settings-button2-0" value="📊 Сбор через опрос: включён" style="rounded=1;arcSize=10;fillColor=#414b55;strokeColor=#414b55;fontColor=#ecf5ff;fontSize=14;align=center;verticalAlign=middle;spacing=6;html=0;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="screen-rules_settings">
