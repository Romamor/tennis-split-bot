          <mxGeometry as="geometry" x="2870" y="3910" width="310" height="160" />
        </mxCell>
        <mxCell id="I-back" value="Назад → список администраторов&#10;Меню → A; страницы → F&#10;Одинаковые имена → профиль D" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#8290a3;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3240" y="3910" width="310" height="160" />
        </mxCell>
        <mxCell id="footer" value="Общие возвраты и ошибки — раздел F. Одинаковые имена → проверка профиля; новая текстовая реплика → ответ внизу личного чата.&#10;Это схема реализованных маршрутов. Поля «ходит» / никнейм и представительство в переводах не имеют отдельного пользовательского интерфейса." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#8290a3;fontColor=#20304a;fontFamily=Arial;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="4700" width="3600" height="80" />
        </mxCell>
